{
  "family": "floodguard-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "${EXEC_ROLE}",
  "taskRoleArn": "${TASK_ROLE}",
  "ephemeralStorage": {
    "sizeInGiB": 21
  },
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "${IMAGE}",
      "essential": true,
      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "POSTGRES_HOST",
          "value": "${DB_HOST}"
        },
        {
          "name": "POSTGRES_PORT",
          "value": "5432"
        },
        {
          "name": "POSTGRES_USER",
          "value": "fgadmin"
        },
        {
          "name": "POSTGRES_DB",
          "value": "floodguard"
        },
        {
          "name": "REDIS_URL",
          "value": "rediss://${REDIS_HOST}:6379/0?ssl_cert_reqs=required"
        },
        {
          "name": "CORS_ORIGINS",
          "value": "${CORS_ORIGINS_JSON}"
        },
        {
          "name": "CORS_ORIGIN_REGEX",
          "value": "${CORS_REGEX}"
        },
        {
          "name": "MODEL_ARTIFACTS_S3_URI",
          "value": "s3://${BUCKET}/models"
        },
        {
          "name": "VAPID_SUBJECT",
          "value": "${FRONTEND_ORIGIN}"
        },
        {
          "name": "EMERGENCY_AUTO_OFFICIAL_ALERTS",
          "value": "true"
        },
        {
          "name": "SKIP_MODEL_FETCH",
          "value": "1"
        },
        {
          "name": "GEO_CACHE_S3_URI",
          "value": "s3://${BUCKET}/geo-cache"
        }
      ],
      "secrets": [
        {
          "name": "SECRET_KEY",
          "valueFrom": "${SECRET_ARN}:SECRET_KEY::"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "${SECRET_ARN}:POSTGRES_PASSWORD::"
        },
        {
          "name": "VAPID_PUBLIC_KEY",
          "valueFrom": "${SECRET_ARN}:VAPID_PUBLIC_KEY::"
        },
        {
          "name": "VAPID_PRIVATE_KEY",
          "valueFrom": "${SECRET_ARN}:VAPID_PRIVATE_KEY::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/floodguard",
          "awslogs-region": "${REGION}",
          "awslogs-stream-prefix": "worker"
        }
      },
      "stopTimeout": 30,
      "readonlyRootFilesystem": false,
      "user": "10001:10001",
      "command": [
        "celery",
        "-A",
        "app.core.celery_app",
        "worker",
        "--loglevel=info",
        "--concurrency=2"
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "celery -A app.core.celery_app inspect ping -d celery@$HOSTNAME --timeout 10 || exit 1"
        ],
        "interval": 60,
        "timeout": 20,
        "retries": 3,
        "startPeriod": 90
      }
    }
  ],
  "tags": [
    {
      "key": "Project",
      "value": "floodguard"
    }
  ]
}