# =============================================================================
# FloodGuard SIH 26192 - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=DEBUG
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Database (PostgreSQL + PostGIS + TimescaleDB)
# -----------------------------------------------------------------------------
POSTGRES_DB=floodguard
POSTGRES_USER=floodguard
POSTGRES_PASSWORD=floodguard_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy async URL (used by backend)
DATABASE_URL=postgresql+asyncpg://floodguard:floodguard_dev_password@localhost:5432/floodguard

# Sync URL for Alembic migrations
ALEMBIC_DATABASE_URL=postgresql://floodguard:floodguard_dev_password@localhost:5432/floodguard

# -----------------------------------------------------------------------------
# Redis (Caching, Celery broker, Sessions)
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# External API Keys (Optional - for enhanced data)
# -----------------------------------------------------------------------------
# Open-Meteo (Free, no key required for basic usage)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# India Meteorological Department (IMD) - Requires registration
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=

# MOSDAC (ISRO) - Requires registration
MOSDAC_API_BASE_URL=https://mosdac.gov.in/api
MOSDAC_API_KEY=

# Bhuvan (ISRO/NRSC) - Requires registration
BHUVAN_API_BASE_URL=https://bhuvan.nrsc.gov.in/api
BHUVAN_API_KEY=

# Google Earth Engine (for satellite data) - Requires service account
GEE_SERVICE_ACCOUNT_KEY_PATH=

# MapTiler (for vector tiles) - Free tier available
MAPTILER_KEY=

# Mapbox (alternative for vector tiles) - Free tier available
MAPBOX_TOKEN=

# -----------------------------------------------------------------------------
# Email/SMS Notifications (Optional)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@floodguard.in

# Twilio for SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase Cloud Messaging (Push notifications)
FCM_SERVER_KEY=
FCM_SENDER_ID=

# -----------------------------------------------------------------------------
# LLM / AI Assistant (Optional)
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:70b

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/api/v1
VITE_MAPTILER_KEY=
VITE_MAPBOX_TOKEN=
VITE_APP_TITLE=FloodGuard - Flash Flood Prediction System
VITE_APP_DESCRIPTION=Real-time flood risk prediction for South India's hilly regions

# -----------------------------------------------------------------------------
# Monitoring & Observability (Optional)
# -----------------------------------------------------------------------------
SENTRY_DSN=
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# -----------------------------------------------------------------------------
# Data Processing
# -----------------------------------------------------------------------------
# CHIRPS data directory (for local processing)
CHIRPS_DATA_DIR=/data/chirps

# DEM data directory
DEM_DATA_DIR=/data/dem

# Temporary processing directory
TEMP_DATA_DIR=/tmp/floodguard

# -----------------------------------------------------------------------------
# Development/Testing
# -----------------------------------------------------------------------------
PYTEST_ADDOPTS=-v --tb=short
COVERAGE_THRESHOLD=80
# -----------------------------------------------------------------------------
# Web Push (VAPID) for emergency alerts — generate with:
#   docker compose exec backend python scripts/generate_vapid_keys.py --subject mailto:ops@your-agency.example
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@your-agency.example
# Emergency response tuning (defaults shown)
# EMERGENCY_LOCATION_STALE_MINUTES=15
# EMERGENCY_TARGET_LOCATION_MAX_AGE_HOURS=24
# EMERGENCY_ARRIVAL_RADIUS_M=200
# EMERGENCY_LOCATION_RETENTION_HOURS=72
# EMERGENCY_RESCUE_RETENTION_DAYS=30
# EMERGENCY_AUTO_OFFICIAL_ALERTS=true
# ROUTING_FOOT_BASE_URL=https://routing.openstreetmap.de/routed-foot
# ROUTING_BASE_URL=https://router.project-osrm.org
# Extra dev-server hostnames (e.g. an HTTPS tunnel for phone testing), comma separated
# VITE_ALLOWED_HOSTS=
# Production-only (set via ECS task definition / Secrets Manager — see docs/DEPLOYMENT.md)
# CORS_ORIGINS=["https://floodguard.techmavericks.me"]
# CORS_ORIGIN_REGEX=^https://floodguard(-[a-z0-9-]+)?(-abdulmunafzs-projects)?\.vercel\.app$
# MODEL_ARTIFACTS_S3_URI=s3://<bucket>/models
